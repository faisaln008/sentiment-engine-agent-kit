# ── Server ─────────────────────────────────────────────
# Bind address. Default is loopback only. 0.0.0.0 is an EXPLICIT opt-in: the API and the WebSocket have no
# authentication and broadcast every session's excerpts, so any host on your LAN could watch live negotiations.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── LLM: primary (any OpenAI-compatible endpoint) ──────
# Groq (free tier): https://console.groq.com/keys
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_API_KEY=
# Verify current model IDs at build time (free-tier catalogs change); record choice in specs/adr/001
LLM_PRIMARY_MODEL=qwen/qwen3.8-27b
# CP1 default (reports/ab-cp1.md, ADR-005): qwen3.8-27b with effort none. Empty value = field omitted (use for
# models that reject it, e.g. llama-3.1-8b-instant where your org has it). Optional (empty = field omitted): none|minimal|low|medium|high. For Groq gpt-oss models also sends include_reasoning:false.
LLM_PRIMARY_REASONING_EFFORT=none

# ── LLM: fallback ──────────────────────────────────────
# Google AI Studio (free tier): https://aistudio.google.com/apikey  (OpenAI-compatible endpoint)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_REASONING_EFFORT=
# Alternatives: Cerebras https://api.cerebras.ai/v1 · Ollama http://localhost:11434/v1 (API key: any string)

# ── Latency controls ───────────────────────────────────
# Deadline is counted from request arrival; on expiry the rule-based classifier answers.
# Fallback provider is used only on error / 429 / open circuit (no timer hedge — ADR-001).
LLM_DEADLINE_MS=450
LLM_MAX_TOKENS=90
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_MS=15000
LLM_MAX_INFLIGHT=16

# ── Analysis ───────────────────────────────────────────
CONTEXT_TURNS=3
VOLATILITY_THRESHOLD=0.6
SESSION_TTL_MS=1800000
MAX_SESSIONS=1000
MAX_TEXT_CHARS=2000

# ── WebSocket ──────────────────────────────────────────
WS_MAX_CLIENTS=50
WS_PING_INTERVAL_MS=30000

# No keys set? The server still starts and uses the rule-based classifier (logged once as WARN).
